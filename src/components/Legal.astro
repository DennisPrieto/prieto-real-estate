---
interface Props { title: string; intro?: string }
const { title, intro } = Astro.props;
---
<section class="ph-legal">
  <div class="wrap legal-wrap">
    <h1 class="h2">{title}</h1>
    {intro && <p class="lede" style="margin-top:24px">{intro}</p>}
    <div class="legal-body"><slot /></div>
  </div>
</section>
<style>
  .ph-legal { padding: clamp(56px, 8vw, 112px) 0; }
  .legal-wrap { max-width: 860px; }
  .legal-body { margin-top: 48px; border-top: 1px solid var(--rule); padding-top: 24px; }
  .legal-body :global(h2) { font-family: var(--font-display); font-size: 27px; font-weight: 500; margin-top: 36px; }
  .legal-body :global(p) { margin-top: 12px; color: var(--ink-2); max-width: 70ch; }
  .legal-body :global(a) { color: var(--ink); text-decoration-color: var(--gold); }
</style>
