---
import { WIDTH, HEIGHT, project, shorePath, landPath, islands, contours, soundings, PLACES, bayLabel, oceanLabel, latTicks, lonTicks } from '../data/bay.js';

interface Props {
  focus?: string | null;
  tone?: 'light' | 'dark';
  animate?: boolean;
  label?: string;
  class?: string;
}
const { focus = null, tone = 'light', animate = false, label, class: cls = '' } = Astro.props;

let vb = [0, 0, WIDTH, HEIGHT];
if (focus && PLACES[focus]) {
  const [x, y] = project(PLACES[focus].at);
  const w = 420, h = 360;
  const vx = Math.max(0, Math.min(WIDTH - w, x - w * 0.45));
  const vy = Math.max(0, Math.min(HEIGHT - h, y - h * 0.5));
  vb = [vx, vy, w, h];
}
const fs = +(vb[2] / (focus ? 30 : 58)).toFixed(1);
const places = Object.entries(PLACES).map(([slug, p]: [string, any]) => ({ slug, name: p.name, xy: project(p.at), dy: p.dy || 0, side: p.side || 'l', island: !!p.island }));
const dirOf = (p: any) => p.slug === focus ? (p.xy[0] - vb[0] > vb[2] * 0.5 ? 'l' : 'r') : p.side;
const title = label || (focus ? `Schematic chart of Biscayne Bay centred on ${PLACES[focus]?.name}` : `Schematic chart of the coast from Aventura to Gables by the Sea, marking ${Object.values(PLACES).map((p) => p.name).join(', ')}`);
---
<figure class:list={['bay', `bay--${tone}`, { 'bay--animate': animate, 'bay--focus': !!focus }, cls]}>
  <svg viewBox={vb.join(' ')} preserveAspectRatio="xMidYMid slice" role="img" aria-label={title}>
    <rect x="0" y="0" width={WIDTH} height={HEIGHT} class="bay-water" />
    <g class="bay-contours">
      {contours.map((d, i) => <path d={d} class={`c c${i}`} />)}
    </g>
    <g class="bay-soundings" font-size={fs * 0.82}>
      {soundings.map((s) => <text x={s.xy[0]} y={s.xy[1]}>{s.v}</text>)}
    </g>
    <path d={landPath} class="bay-land" />
    {islands.map((d) => <path d={d} class="bay-island" />)}
    <path d={shorePath} class="bay-shore" pathLength="1" />
    <text x={bayLabel[0]} y={bayLabel[1]} class="bay-name" font-size={fs * 1.5}>Biscayne Bay</text>
    {!focus && <text x={oceanLabel[0]} y={oceanLabel[1]} class="bay-name" font-size={fs * 1.3} transform={`rotate(-90 ${oceanLabel[0]} ${oceanLabel[1]})`} text-anchor="middle">Atlantic Ocean</text>}
    <g class="bay-places" font-size={fs}>
      {places.map((p) => (
        <g class:list={['place', { 'is-focus': p.slug === focus, 'on-water': dirOf(p) === 'r' || p.island }]}>
          <circle cx={p.xy[0]} cy={p.xy[1]} r={fs * (p.slug === focus ? 0.5 : 0.36)} />
          {p.slug === focus
            ? (p.xy[0] - vb[0] > vb[2] * 0.5
                ? <text x={p.xy[0] - fs * 0.9} y={p.xy[1] + fs * 0.35} text-anchor="end">{p.name.toUpperCase()}</text>
                : <text x={p.xy[0] + fs * 0.9} y={p.xy[1] + fs * 0.35} text-anchor="start">{p.name.toUpperCase()}</text>)
            : p.side === 'r'
              ? <text x={p.xy[0] + fs * 0.8} y={p.xy[1] + fs * (0.35 + p.dy)} text-anchor="start">{p.name.toUpperCase()}</text>
              : <text x={p.xy[0] - fs * 0.8} y={p.xy[1] + fs * (0.35 + p.dy)} text-anchor="end">{p.name.toUpperCase()}</text>}
        </g>
      ))}
    </g>
    {!focus && (
      <g class="bay-grid" font-size={fs * 0.72}>
        {latTicks.map((t) => (<g><line x1="0" x2={fs * 0.7} y1={t.y} y2={t.y} /><text x={fs} y={t.y + fs * 0.25}>{t.label}</text></g>))}
        {lonTicks.map((t) => (<g><line x1={t.x} x2={t.x} y1={HEIGHT} y2={HEIGHT - fs * 0.7} /><text x={t.x + fs * 0.3} y={HEIGHT - fs * 0.9}>{t.label}</text></g>))}
      </g>
    )}
  </svg>
  <figcaption>Schematic. Not to scale or for navigation. Soundings illustrative.</figcaption>
</figure>

<style>
  .bay { position: relative; margin: 0; }
  .bay svg { display: block; width: 100%; height: 100%; }
  .bay figcaption { font-family: var(--font-label); font-size: 11px; letter-spacing: .08em; color: var(--graphite); margin-top: .5rem; }
  .bay-water { fill: var(--water); }
  .bay-land, .bay-island { fill: var(--ivory); }
  .bay-island { stroke: var(--ink); stroke-width: 1; }
  .bay-shore { fill: none; stroke: var(--ink); stroke-width: 1.4; }
  .bay-contours path { fill: none; stroke: var(--water-line); stroke-width: .8; opacity: .55; }
  .bay-contours .c1 { stroke-dasharray: 5 5; }
  .bay-contours .c2 { stroke-dasharray: 1.5 6; }
  .bay-soundings text { font-family: var(--font-label); fill: var(--water-text); }
  .bay-name { font-family: var(--font-display); font-style: italic; fill: var(--water-text); }
  .bay-places text { font-family: var(--font-label); letter-spacing: .14em; fill: var(--ink); paint-order: stroke; stroke: var(--ivory); stroke-width: 3.5px; stroke-linejoin: round; }
  .bay-places circle { fill: var(--gold); stroke: var(--ink); stroke-width: .8; }
  .bay-places .is-focus circle { stroke-width: 1.4; }
  .bay-places .is-focus text { font-weight: 500; }
  .bay-places .on-water text { fill: var(--ivory); stroke: var(--water); stroke-width: 3px; }
  .bay--focus .bay-places g:not(.is-focus) { opacity: .6; }
  .bay-grid line { stroke: var(--ink); stroke-width: .8; opacity: .55; }
  .bay-grid text { font-family: var(--font-label); fill: var(--graphite); letter-spacing: .06em; }

  .bay--dark .bay-water { fill: #141412; }
  .bay--dark .bay-land, .bay--dark .bay-island { fill: var(--ink); }
  .bay--dark .bay-shore, .bay--dark .bay-island, .bay--dark .bay-contours path { stroke: var(--gold); }
  .bay--dark .bay-places text { fill: var(--ivory); }
  .bay--dark .bay-soundings text, .bay--dark .bay-name, .bay--dark .bay-grid text { fill: #A89F8C; }
  .bay--dark .bay-grid line { stroke: var(--gold); }
  .bay--dark figcaption { color: #A89F8C; }

  .bay--animate .bay-shore { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 2.4s cubic-bezier(.16,1,.3,1) .2s forwards; }
  .bay--animate .bay-places g { opacity: 0; animation: fade .8s cubic-bezier(.16,1,.3,1) forwards; }
  .bay--animate .bay-places g:nth-child(1) { animation-delay: 1.1s; }
  .bay--animate .bay-places g:nth-child(2) { animation-delay: 1.3s; }
  .bay--animate .bay-places g:nth-child(3) { animation-delay: 1.5s; }
  .bay--animate .bay-places g:nth-child(4) { animation-delay: 1.7s; }
  .bay--animate .bay-places g:nth-child(n+5) { animation-delay: 1.9s; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .bay--animate .bay-shore { animation: none; stroke-dashoffset: 0; }
    .bay--animate .bay-places g { animation: none; opacity: 1; }
  }
  @media (max-width: 720px) {
    .bay:not(.bay--focus) .bay-soundings, .bay:not(.bay--focus) .bay-contours .c2 { display: none; }
  }
</style>
