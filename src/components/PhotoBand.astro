---
import Photo from './Photo.astro';
interface Props { name: string; position?: string }
const { name, position = 'center' } = Astro.props;
---
<section class="pband" aria-label="Photograph">
  <Photo name={name} ratio="21 / 8" overlayCredit sizes="100vw" position={position} />
</section>
<style>
  /* Full width at every screen size: cap the height, never the width. */
  .pband :global(.frame) { aspect-ratio: auto; width: 100%; height: min(560px, calc(100vw * 8 / 21)); }
  @media (max-width: 720px) { .pband :global(.frame) { height: 75vw; } }
</style>
