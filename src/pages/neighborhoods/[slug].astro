---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import BayChart from '../../components/BayChart.astro';
import Photo from '../../components/Photo.astro';
import { PHOTOS } from '../../data/photos.js';
import ConsultBand from '../../components/ConsultBand.astro';
import Arrow from '../../components/Arrow.astro';
import { NEIGHBORHOODS } from '../../data/places.js';

export function getStaticPaths() {
  return NEIGHBORHOODS.map((n) => ({ params: { slug: n.slug }, props: { n } }));
}
const { n } = Astro.props;
const hasPhoto = n.slug in PHOTOS;
const idx = NEIGHBORHOODS.findIndex((o) => o.slug === n.slug);
const others = NEIGHBORHOODS.filter((o, i) => o.slug !== n.slug && Math.abs(i - idx) <= 3);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Residential', item: 'https://www.prietoreal.estate/residential' },
    { '@type': 'ListItem', position: 2, name: n.name, item: `https://www.prietoreal.estate/neighborhoods/${n.slug}` },
  ],
};
---
<Base title={n.title} description={n.description} schema={schema}>
  <PageHead title={n.name} lede={n.lede} coord={n.coord} crumbs={[['/residential', 'Residential'], [`/neighborhoods/${n.slug}`, n.name]]}>
    <div class="btn-row">
      <a href="/sellers#valuation" class="btn btn--primary">Value a home here <Arrow /></a>
      <a href="/buyers" class="btn btn--ghost">Buy here</a>
    </div>
    <div slot="aside" class="nb-hero-photo">{hasPhoto ? <Photo name={n.slug} eager ratio="4 / 5" sizes="(max-width: 960px) 100vw, 45vw" /> : <div class="nb-hero-chart"><BayChart focus={n.slug} /></div>}</div>
  </PageHead>

  <section class="section">
    <div class="wrap nb-body">
      <div data-reveal>
        <div class="prose">
          <h2 class="h3">The place</h2>
          {n.place.map((p) => <p>{p}</p>)}
        </div>
        {hasPhoto && <div class="nb-chart"><BayChart focus={n.slug} /></div>}
      </div>
      <div data-reveal>
        <h2 class="h3">What we check before pricing here</h2>
        <dl class="legend" style="margin-top:28px">
          {n.checks.map(([t, d]) => (<div><dt>{t}</dt><dd>{d}</dd></div>))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--shoal section--tight">
    <div class="wrap">
      <h2 class="h4">Nearby on the chart</h2>
      <ul class="others">
        {others.map((o) => (<li><a href={`/neighborhoods/${o.slug}`}><span>{o.name}</span><span class="coord">{o.coord}</span></a></li>))}
        <li><a href="/commercial/land-and-assemblages"><span>Land and assemblages</span><span class="coord">By site</span></a></li>
      </ul>
    </div>
  </section>

  <ConsultBand heading={`Thinking about ${n.name}?`} />
</Base>

<style>
  .nb-hero-photo { max-width: 560px; justify-self: end; width: 100%; }
  .nb-hero-chart { aspect-ratio: 4 / 5; border: 1px solid var(--rule); }
  .nb-hero-chart :global(.bay), .nb-hero-chart :global(svg) { height: 100%; }
  .nb-chart { margin-top: 40px; aspect-ratio: 7 / 6; border: 1px solid var(--rule); }
  .nb-chart :global(.bay), .nb-chart :global(svg) { height: 100%; }
  .nb-chart :global(figcaption) { display: none; }
  .nb-body { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px 88px; }
  .nb-body .prose p { margin-top: 18px; }
  @media (max-width: 960px) { .nb-body { grid-template-columns: 1fr; } }
  .others { margin-top: 24px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--rule); }
  @media (max-width: 760px) { .others { grid-template-columns: 1fr; } }
  .others a { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 18px 16px 18px 0; border-bottom: 1px solid var(--rule); color: var(--ink); text-decoration: none; font-family: var(--font-display); font-size: 22px; font-weight: 500; }
  .others a:hover span:first-child { text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 1.5px; }
</style>
