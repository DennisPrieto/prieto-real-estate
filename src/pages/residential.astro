---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import BayChart from '../components/BayChart.astro';
import Photo from '../components/Photo.astro';
import Testimonials from '../components/Testimonials.astro';
import ConsultBand from '../components/ConsultBand.astro';
import Arrow from '../components/Arrow.astro';
import { NEIGHBORHOODS, REGIONS } from '../data/places.js';
import PlaceImage from '../components/PlaceImage.astro';
---
<Base title="Luxury residential real estate in Miami-Dade and Broward" description="Selling or buying a significant home in Coral Gables, Coconut Grove, Brickell, Edgewater or Pinecrest. Jaelly & Dennis Prieto, Epique Realty, in English and Spanish.">
  <PageHead title="Luxury residential" lede="For owners selling a significant home and for buyers choosing one. Every engagement starts with the property’s record and its real buyer pool, then the Epique Estates marketing program puts it in front of them.">
    <div class="btn-row">
      <a href="/sellers" class="btn btn--primary">Selling <Arrow /></a>
      <a href="/buyers" class="btn btn--ghost">Buying</a>
      <a href="/international" class="btn btn--ghost">Buying from abroad</a>
    </div>
    <div slot="aside"><Photo name="coral-gables" eager ratio="5 / 4" sizes="(max-width: 960px) 100vw, 45vw" /></div>
  </PageHead>

  <section class="section">
    <div class="wrap">
      <h2 class="h2" data-reveal>Seventeen places, Aventura to Gables by the Sea</h2>
      {REGIONS.map((r) => (
        <div class="region">
          <h3 class="label region-h">{r.name}</h3>
          <ol class="nb-list">
            {NEIGHBORHOODS.filter((n) => n.region === r.key).map((n) => (
              <li>
                <a href={`/neighborhoods/${n.slug}`}>
                  <span class="nb-thumb"><PlaceImage slug={n.slug} ratio="4 / 3" sizes="160px" /></span>
                  <span class="h3">{n.name}<span class="coord nb-coord">{n.coord}</span></span>
                  <span class="nb-lede">{n.lede}</span>
                  <Arrow />
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))}
      <p class="small muted" style="margin-top:28px">We also represent clients elsewhere in Miami-Dade and Broward. <a class="textlink" href="/contact">Ask about an area</a>.</p>
    </div>
  </section>

  <section class="section section--shoal">
    <div class="wrap two">
      <div data-reveal>
        <h2 class="h2">For sellers</h2>
        <p class="lede" style="margin-top:20px">A written diagnosis of your home before a price: municipality, permits, roof and insurance, condominium health where it applies, and the buyers who will actually pay for it. Then Epique Estates marketing, in English and Spanish.</p>
        <a href="/sellers" class="textlink" style="display:inline-block;margin-top:24px">How we sell a home</a>
      </div>
      <div data-reveal>
        <h2 class="h2">For buyers</h2>
        <p class="lede" style="margin-top:20px">We read the building file, the permit history and the flood data on the homes you like, so your offer prices what you are actually buying. On and off the MLS.</p>
        <a href="/buyers" class="textlink" style="display:inline-block;margin-top:24px">How we help you buy</a>
      </div>
    </div>
  </section>

  <Testimonials />
  <ConsultBand />
</Base>

<style>
  .res-map { aspect-ratio: 1 / 1; max-height: 560px; border: 1px solid var(--rule); }
  .res-map :global(.bay) { height: 100%; }
  .res-map :global(svg) { height: 100%; }
  .res-map :global(figcaption) { display: none; }
  .region { margin-top: 48px; }
  .region-h { margin-bottom: 12px; }
  .nb-thumb { display: block; overflow: hidden; }
  .nb-list { border-top: 1px solid var(--rule); }
  .nb-list a { display: grid; grid-template-columns: 10rem minmax(0, 18rem) minmax(0, 1fr) 24px; gap: 8px 40px; align-items: baseline; padding: 30px 0; border-bottom: 1px solid var(--rule); color: var(--ink); text-decoration: none; transition: padding .45s var(--ease); }
  .nb-list a:hover { padding-left: 10px; }
  .nb-list a { align-items: center; }
  .nb-coord { display: block; margin-top: 6px; }
  .nb-list .nb-lede { color: var(--ink-2); font-size: 16px; max-width: 60ch; }
  @media (max-width: 860px) { .nb-list a { grid-template-columns: 7rem minmax(0, 1fr) 24px; } .nb-list .nb-lede { grid-column: 1 / -1; } }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px 88px; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }
</style>
