---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page could not be found." noindex>
  <section class="section">
    <div class="wrap">
      <p class="coord">0°00′N 0°00′W</p>
      <h1 class="display" style="margin-top:20px">Off the chart.</h1>
      <p class="lede" style="margin-top:24px">That page isn’t here. It may have moved when we rebuilt the site.</p>
      <div class="btn-row" style="margin-top:32px">
        <a href="/" class="btn btn--primary">Go to the homepage</a>
        <a href="/contact" class="btn btn--ghost">Contact us</a>
      </div>
    </div>
  </section>
</Base>
